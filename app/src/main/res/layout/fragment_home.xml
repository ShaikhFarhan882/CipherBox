<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="?android:colorBackground">

        <!-- App Header -->
        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CipherBox"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/select_method_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <!-- Encryption Method Label -->
        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/select_method_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Select Encryption Method"
            android:textAppearance="?android:attr/textAppearanceMedium"
            app:layout_constraintTop_toBottomOf="@id/header_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Spinner for Methods -->
        <Spinner
            android:id="@+id/method_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            app:layout_constraintTop_toBottomOf="@id/select_method_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

        <!-- Input EditText -->
        <EditText
            android:id="@+id/input_text"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:background="@drawable/edit_text_background"
            android:hint="Enter text to encrypt"
            android:gravity="top|start"
            android:textSize="16sp"
            android:inputType="textMultiLine"
            android:maxLines="8"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/method_spinner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Encrypt Button -->
        <Button
            android:id="@+id/encrypt_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encrypt"
            app:layout_constraintTop_toBottomOf="@id/input_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Output View -->
        <EditText
            android:id="@+id/output_text"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:background="@drawable/edit_text_background"
            android:hint="Encrypted/Hashed output"
            android:gravity="top|start"
            android:textSize="16sp"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:maxLines="8"
            android:focusable="false"
            android:clickable="false"
            app:layout_constraintTop_toBottomOf="@id/encrypt_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />


        <!-- Encrypt Button -->
        <Button
            android:id="@+id/copy_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy"
            app:layout_constraintTop_toBottomOf="@id/output_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
